# WATI / WhatsApp. En WATI configura el webhook como:
# https://tu-dominio.com/api/wati/webhook?token=<WATI_WEBHOOK_SECRET>
# y activa únicamente el evento "Message Received".
WATI_API_TOKEN=""
WATI_BASE_URL="https://live-mt-server.wati.io/<tenantId>"
WATI_WEBHOOK_SECRET=""
# Se usa para autorizar el cron de seguimiento de WhatsApp.
CRON_SECRET="replace-with-a-long-random-secret"
ODOO_URL="https://gcinternational1.odoo.com"
ODOO_DB="gcinternational1"
ODOO_USERNAME="tu-email-de-odoo"
ODOO_API_KEY="tu-api-key-de-odoo"

